@model List<QuanLyKyTucXa_UNETIxx_xxx.Models.PhanPhong>
@using QuanLyKyTucXa_UNETIxx_xxx.Models
@{ ViewData["Title"]="Chuyển phòng"; var rooms=(List<PhongKTX>)ViewBag.Phongs; }
<div class="page-head"><div><h1>Chuyển phòng</h1><p>Thực hiện chuyển sinh viên sang phòng khác.</p></div></div><div class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Sinh viên</th><th>Phòng hiện tại</th><th>Ngày vào</th><th>Phòng mới</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.SinhVien?.MaSV</b><br/>@x.SinhVien?.HoTen</td><td>Tòa @x.PhongKTX?.ToaNha - @x.PhongKTX?.SoPhong</td><td>@x.NgayVao.ToString("dd/MM/yyyy")</td><td><form asp-action="Move" method="post" class="d-flex gap-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><select name="phongId" class="form-select form-select-sm">@foreach(var p in rooms.Where(r=>r.Id!=x.PhongKTXId)){<option value="@p.Id">@p.ToaNha - @p.SoPhong (@p.LoaiPhong?.TenLoai)</option>}</select><button class="btn btn-sm btn-primary">Chuyển</button></form></td><td></td></tr>}</tbody></table></div></div>
