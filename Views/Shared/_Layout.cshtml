@using Microsoft.AspNetCore.Http
@using Microsoft.EntityFrameworkCore
@using QuanLyKyTucXa_UNETIxx_xxx.Data
@inject KtxDbContext KtxDb
@{
    var isLoggedIn = Context.Session.GetInt32("UserId") != null;
    var role = Context.Session.GetString("Role");
    var isAdmin = role == "Admin";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var pendingStudentNotifications = isAdmin ? await KtxDb.SinhViens.CountAsync(s => !s.DangKys.Any() && !s.PhanPhongs.Any(p => p.NgayRa == null)) : 0;
    var pendingRegistrationNotifications = isAdmin ? await KtxDb.DangKyKTXs.CountAsync(x => x.TrangThai == "ChoDuyet") : 0;
    var pendingAssignmentNotifications = isAdmin ? await KtxDb.DangKyKTXs.CountAsync(x => x.TrangThai == "ChoDuyet" && KtxDb.PhongKTXs.Any(p => p.DangHoatDong && p.LoaiPhongId == x.LoaiPhongId && KtxDb.PhanPhongs.Count(pp => pp.PhongKTXId == p.Id && pp.NgayRa == null) < KtxDb.LoaiPhongs.Where(lp => lp.Id == p.LoaiPhongId).Select(lp => lp.SucChua).FirstOrDefault())) : 0;
    var pendingTransferNotifications = isAdmin ? await KtxDb.YeuCauChuyenPhongs.CountAsync(x => x.TrangThai == "ChoDuyet") : 0;
    var pendingReturnNotifications = isAdmin ? await KtxDb.DangKyKTXs.CountAsync(x => x.TrangThai == "YeuCauTra") : 0;
    var totalNotifications = pendingStudentNotifications + pendingRegistrationNotifications + pendingAssignmentNotifications + pendingTransferNotifications + pendingReturnNotifications;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ký Túc Xá UNETI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin-body">
@if (isLoggedIn && isAdmin)
{
    <div class="admin-shell">
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="brand">
                <div class="brand-icon">🏢</div>
                <div><div class="brand-title">Ký Túc Xá</div><div class="brand-subtitle">UNETI ADMIN</div></div>
            </div>

            <nav class="admin-nav">
                <div class="nav-section">QUẢN LÝ</div>
                <a class="admin-nav-link @(currentController == "TaiKhoan" ? "active" : "")" asp-controller="TaiKhoan" asp-action="Index"><span class="nav-icon">👥</span><span class="nav-link-text">Tài khoản</span></a>
                <a class="admin-nav-link @(currentController == "SinhVien" ? "active" : "")" asp-controller="SinhVien" asp-action="Index"><span class="nav-icon">🎓</span><span class="nav-link-text">Sinh viên</span>@if (pendingStudentNotifications > 0) { <b class="notification-badge">@pendingStudentNotifications</b> }</a>
                <a class="admin-nav-link @(currentController == "LoaiPhong" ? "active" : "")" asp-controller="LoaiPhong" asp-action="Index"><span class="nav-icon">▤</span><span class="nav-link-text">Loại phòng</span></a>
                <a class="admin-nav-link @(currentController == "PhongKTX" ? "active" : "")" asp-controller="PhongKTX" asp-action="Index"><span class="nav-icon">🏢</span><span class="nav-link-text">Phòng KTX</span></a>

                <div class="nav-section nav-section-spaced">YÊU CẦU &amp; XỬ LÝ</div>
                <a class="admin-nav-link @(currentController == "DonDangKy" ? "active" : "")" asp-controller="DonDangKy" asp-action="Index"><span class="nav-icon">▧</span><span class="nav-link-text">Đăng ký KTX</span>@if (pendingRegistrationNotifications > 0) { <b class="notification-badge">@pendingRegistrationNotifications</b> }</a>
                <a class="admin-nav-link @(currentController == "PhanPhong" ? "active" : "")" asp-controller="PhanPhong" asp-action="Index"><span class="nav-icon">⇄</span><span class="nav-link-text">Phân phòng</span>@if (pendingAssignmentNotifications > 0) { <b class="notification-badge">@pendingAssignmentNotifications</b> }</a>
                <a class="admin-nav-link @(currentController == "ChuyenPhong" ? "active" : "")" asp-controller="ChuyenPhong" asp-action="Index"><span class="nav-icon">↪</span><span class="nav-link-text">Chuyển phòng</span>@if (pendingTransferNotifications > 0) { <b class="notification-badge">@pendingTransferNotifications</b> }</a>
                <a class="admin-nav-link @(currentController == "TraPhong" ? "active" : "")" asp-controller="TraPhong" asp-action="Index"><span class="nav-icon">✓</span><span class="nav-link-text">Trả phòng</span>@if (pendingReturnNotifications > 0) { <b class="notification-badge">@pendingReturnNotifications</b> }</a>

            </nav>

            <div class="sidebar-bottom">
                <div class="admin-badge"><span class="status-dot"></span><span>Đang đăng nhập Admin</span></div>
                <a class="logout-link" asp-controller="Account" asp-action="Logout"><span>↪</span> Đăng xuất</a>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <button class="menu-toggle" type="button" onclick="document.getElementById('adminSidebar').classList.toggle('collapsed'); document.getElementById('adminMain').classList.toggle('expanded');">☰</button>
                <div class="topbar-spacer"></div>
                <div class="topbar-notice-wrap">
                    <button type="button" class="topbar-notice" id="notificationBell" aria-label="Thông báo">🔔 @if (totalNotifications > 0) { <span class="topbar-notice-badge">@totalNotifications</span> }</button>
                    <div class="notification-panel" id="notificationPanel">
                        <div class="notification-panel-head"><strong>Thông báo</strong><span>@totalNotifications mục cần xử lý</span></div>
                        @if (totalNotifications > 0)
                        {
                            @if (pendingStudentNotifications > 0) { <a class="notification-item" asp-controller="SinhVien" asp-action="Index"><span class="notification-icon">🎓</span><span><b>Sinh viên mới</b><small>Có @pendingStudentNotifications sinh viên mới/chưa đăng ký KTX.</small></span></a> }
                            @if (pendingRegistrationNotifications > 0) { <a class="notification-item" asp-controller="DonDangKy" asp-action="Index" asp-route-status="ChoDuyet"><span class="notification-icon">▧</span><span><b>Đơn đăng ký KTX</b><small>Có @pendingRegistrationNotifications đơn đang chờ duyệt.</small></span></a> }
                            @if (pendingAssignmentNotifications > 0) { <a class="notification-item" asp-controller="PhanPhong" asp-action="Index"><span class="notification-icon">⇄</span><span><b>Phân phòng</b><small>Có @pendingAssignmentNotifications đăng ký cần phân phòng.</small></span></a> }
                            @if (pendingTransferNotifications > 0) { <a class="notification-item" asp-controller="ChuyenPhong" asp-action="Index"><span class="notification-icon">↪</span><span><b>Chuyển phòng</b><small>Có @pendingTransferNotifications yêu cầu đang chờ duyệt.</small></span></a> }
                            @if (pendingReturnNotifications > 0) { <a class="notification-item" asp-controller="TraPhong" asp-action="Index"><span class="notification-icon">✓</span><span><b>Trả phòng</b><small>Có @pendingReturnNotifications yêu cầu trả phòng.</small></span></a> }
                        }
                        else
                        {
                            <div class="notification-empty">✓ Không có thông báo mới</div>
                        }
                    </div>
                </div>
                <div class="admin-profile">
                    <div class="avatar">A</div>
                    <div><div class="profile-name">Nguyễn Văn A</div><div class="profile-role">Administrator</div></div>
                </div>
            </header>

            <main class="admin-content" id="adminMain">
                @if (TempData["Msg"] != null) { <div class="alert alert-success shadow-sm border-0">@TempData["Msg"]</div> }
                @if (TempData["Err"] != null) { <div class="alert alert-danger shadow-sm border-0">@TempData["Err"]</div> }
                @RenderBody()
            </main>
        </div>
    </div>
}
else if (isLoggedIn)
{
    <div class="student-shell">
        <aside class="student-sidebar">
            <div class="student-brand">
                <div class="student-brand-icon">🏢</div>
                <div><strong>Ký Túc Xá</strong><span>UNETI STUDENT</span></div>
            </div>
            <nav class="student-nav">
                <div class="student-nav-label">CỔNG SINH VIÊN</div>
                <a class="student-nav-link @(currentController == "DangKyKTX" ? "active" : "")" asp-controller="DangKyKTX" asp-action="Index"><span>⌂</span> Trang chủ</a>
                <a class="student-nav-link" href="#registration"><span>▧</span> Đăng ký KTX</a>
                <a class="student-nav-link" href="#history"><span>◷</span> Lịch sử đăng ký</a>
                <a class="student-nav-link" href="#stay-history"><span>🏠</span> Lịch sử ở KTX</a>
                <a class="student-nav-link @(currentController == "StudentChuyenPhong" ? "active" : "")" asp-controller="StudentChuyenPhong" asp-action="Index"><span>🔄</span> Đăng ký chuyển phòng</a>
            </nav>
            <div class="student-side-bottom">
                <div class="student-user-mini"><div class="student-mini-avatar">@((Context.Session.GetString("UserName") ?? "S").Substring(0,1).ToUpper())</div><div><b>@Context.Session.GetString("UserName")</b><span>Sinh viên</span></div></div>
                <a class="student-logout" asp-controller="Account" asp-action="Logout">↪ &nbsp; Đăng xuất</a>
            </div>
        </aside>
        <div class="student-main">
            <header class="student-topbar">
                <div><span class="student-topbar-title">Cổng sinh viên</span><span class="student-topbar-sub">Quản lý ký túc xá</span></div>
                <div class="student-topbar-right"><span class="student-bell">🔔</span><div class="student-top-user"><b>@Context.Session.GetString("UserName")</b><span>Sinh viên</span></div><a class="student-top-logout" asp-controller="Account" asp-action="Logout">Đăng xuất</a></div>
            </header>
            <main class="student-content">@RenderBody()</main>
        </div>
    </div>
}
else
{
    <main class="auth-page">
        @RenderBody()
    </main>
}
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    const bell = document.getElementById("notificationBell");
    const panel = document.getElementById("notificationPanel");
    if (!bell || !panel) return;
    bell.addEventListener("click", function (e) { e.stopPropagation(); panel.classList.toggle("show"); });
    document.addEventListener("click", function (e) { if (!panel.contains(e.target) && !bell.contains(e.target)) panel.classList.remove("show"); });
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
