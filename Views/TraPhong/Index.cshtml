@model List<QuanLyKyTucXa_UNETIxx_xxx.Models.PhanPhong>
@{ ViewData["Title"]="Trả phòng"; var yeuCauTra = (List<int>)(ViewBag.YeuCauTra ?? new List<int>()); }
<div class="page-head"><div><h1>Trả phòng</h1><p>Quản lý sinh viên đang ở và các yêu cầu trả phòng.</p></div></div>
<div class="panel">
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Sinh viên</th><th>Phòng</th><th>Ngày vào</th><th>Trạng thái yêu cầu</th><th class="text-end">Thao tác</th></tr></thead><tbody>
@foreach(var x in Model){ var requested = yeuCauTra.Contains(x.SinhVienId); <tr>
<td><b>@x.SinhVien?.MaSV</b><br/>@x.SinhVien?.HoTen</td>
<td>Tòa @x.PhongKTX?.ToaNha - @x.PhongKTX?.SoPhong</td>
<td>@x.NgayVao.ToString("dd/MM/yyyy")</td>
<td>@if(requested){<span class="status-pill ChoDuyet">Chờ Admin xác nhận</span>}else{<span class="text-muted">Chưa có yêu cầu</span>}</td>
<td class="text-end"><form asp-action="Return" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm @(requested ? "btn-danger" : "btn-outline-danger")" onclick="return confirm('Xác nhận sinh viên đã trả phòng?')">@(requested ? "Xác nhận trả phòng" : "Ghi nhận trả phòng")</button></form></td>
</tr>}
</tbody></table></div>
@if(!Model.Any()){<div class="empty-state">Hiện không có sinh viên đang ở.</div>}
</div>