@model List<QuanLyKyTucXa_UNETIxx_xxx.Models.PhanPhong>
@{ ViewData["Title"]="Trả phòng"; }
<div class="page-head"><div><h1>Trả phòng</h1><p>Danh sách sinh viên đang ở và xác nhận trả phòng.</p></div></div><div class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Sinh viên</th><th>Phòng</th><th>Ngày vào</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.SinhVien?.MaSV</b><br/>@x.SinhVien?.HoTen</td><td>Tòa @x.PhongKTX?.ToaNha - @x.PhongKTX?.SoPhong</td><td>@x.NgayVao.ToString("dd/MM/yyyy")</td><td class="text-end"><form asp-action="Return" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Xác nhận sinh viên đã trả phòng?')">Xác nhận trả</button></form></td></tr>}</tbody></table></div>@if(!Model.Any()){<div class="empty-state">Hiện không có sinh viên đang ở.</div>}</div>
