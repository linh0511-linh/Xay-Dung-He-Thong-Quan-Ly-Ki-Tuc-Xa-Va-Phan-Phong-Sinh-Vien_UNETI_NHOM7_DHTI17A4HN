@model List<QuanLyKyTucXa_UNETIxx_xxx.Models.DangKyKTX>
@{ ViewData["Title"]="Đăng ký KTX"; }
<div class="page-head"><div><h1>Đơn đăng ký KTX</h1><p>Theo dõi toàn bộ đơn đăng ký của sinh viên.</p></div><a asp-controller="PhanPhong" asp-action="Index" class="btn btn-primary">Duyệt & phân phòng</a></div>
<div class="panel"><div class="filter-tabs"><a class="@(ViewBag.Status==null?"active":"")" asp-action="Index">Tất cả</a><a class="@(ViewBag.Status=="ChoDuyet"?"active":"")" asp-route-status="ChoDuyet">Chờ duyệt</a><a class="@(ViewBag.Status=="DaDuyet"?"active":"")" asp-route-status="DaDuyet">Đã duyệt</a><a class="@(ViewBag.Status=="TuChoi"?"active":"")" asp-route-status="TuChoi">Từ chối</a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Sinh viên</th><th>Loại phòng</th><th>Ngày đăng ký</th><th>Ghi chú</th><th>Trạng thái</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.SinhVien?.MaSV</b><br/>@x.SinhVien?.HoTen</td><td>@x.LoaiPhong?.TenLoai</td><td>@x.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</td><td>@x.GhiChu</td><td><span class="status-pill @x.TrangThai">@(x.TrangThai=="ChoDuyet"?"Chờ duyệt":x.TrangThai=="DaDuyet"?"Đã duyệt":"Từ chối")</span></td></tr>}</tbody></table></div></div>
