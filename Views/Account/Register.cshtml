@model QuanLyKyTucXa_UNETIxx_xxx.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Đăng ký sinh viên"; }

<div class="register-page">
    <div class="register-card">
        <div class="register-brand">
            <div class="register-logo">🎓</div>
            <div>
                <div class="register-brand-title">Ký Túc Xá UNETI</div>
                <div class="register-brand-subtitle">ĐĂNG KÝ TÀI KHOẢN SINH VIÊN</div>
            </div>
        </div>

        <div class="register-heading">
            <h1>Đăng ký sinh viên</h1>
            <p>Tạo tài khoản để đăng nhập và đăng ký ký túc xá</p>
        </div>

        <form asp-action="Register" method="post" class="register-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="register-error"></div>

            <div class="register-grid">
                <div class="register-field">
                    <label asp-for="TenDangNhap"></label>
                    <input asp-for="TenDangNhap" placeholder="Ví dụ: sv001" autocomplete="username" />
                    <span asp-validation-for="TenDangNhap" class="field-error"></span>
                </div>
                <div class="register-field">
                    <label asp-for="MaSV"></label>
                    <input asp-for="MaSV" placeholder="Ví dụ: SV001" />
                    <span asp-validation-for="MaSV" class="field-error"></span>
                </div>
                <div class="register-field">
                    <label asp-for="MatKhau"></label>
                    <input asp-for="MatKhau" type="password" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" />
                    <span asp-validation-for="MatKhau" class="field-error"></span>
                </div>
                <div class="register-field">
                    <label asp-for="XacNhanMatKhau"></label>
                    <input asp-for="XacNhanMatKhau" type="password" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                    <span asp-validation-for="XacNhanMatKhau" class="field-error"></span>
                </div>
                <div class="register-field">
                    <label asp-for="HoTen"></label>
                    <input asp-for="HoTen" placeholder="Nguyễn Văn A" />
                    <span asp-validation-for="HoTen" class="field-error"></span>
                </div>
                <div class="register-field">
                    <label asp-for="NgaySinh"></label>
                    <input asp-for="NgaySinh" type="date" />
                    <span asp-validation-for="NgaySinh" class="field-error"></span>
                </div>
                <div class="register-field">
                    <label asp-for="GioiTinh"></label>
                    <select asp-for="GioiTinh">
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                        <option value="Khác">Khác</option>
                    </select>
                </div>
                <div class="register-field">
                    <label asp-for="Lop"></label>
                    <input asp-for="Lop" placeholder="Ví dụ: DHTI17A5HN" />
                </div>
                <div class="register-field">
                    <label asp-for="Khoa"></label>
                    <input asp-for="Khoa" placeholder="Ví dụ: CNTT" />
                </div>
                <div class="register-field">
                    <label asp-for="SoDienThoai"></label>
                    <input asp-for="SoDienThoai" placeholder="Số điện thoại" />
                    <span asp-validation-for="SoDienThoai" class="field-error"></span>
                </div>
                <div class="register-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" type="email" placeholder="sv001@example.com" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <div class="register-field register-full">
                    <label asp-for="DiaChi"></label>
                    <input asp-for="DiaChi" placeholder="Địa chỉ hiện tại" />
                </div>
            </div>

            <button type="submit" class="register-button">🎓 Đăng ký tài khoản</button>
        </form>

        <div class="register-login">Đã có tài khoản? <a asp-action="Login">Đăng nhập ngay</a></div>
        <div class="register-footer">© 2026 Ký Túc Xá UNETI</div>
    </div>
</div>

<style>
    .register-page{min-height:100vh;background:#f4f7fb;padding:35px 16px;display:flex;justify-content:center;align-items:flex-start}
    .register-card{width:min(900px,100%);background:#fff;border:1px solid #e3e9f2;border-radius:20px;box-shadow:0 16px 45px rgba(20,45,80,.10);padding:32px}
    .register-brand{display:flex;align-items:center;gap:14px;margin-bottom:25px}
    .register-logo{width:50px;height:50px;border-radius:14px;background:#edf3ff;display:flex;align-items:center;justify-content:center;font-size:26px}
    .register-brand-title{font-size:20px;font-weight:800;color:#1c2a41}.register-brand-subtitle{font-size:11px;color:#71809a;letter-spacing:.6px;margin-top:3px}
    .register-heading h1{font-size:28px;margin:0;color:#1d2b43;font-weight:800}.register-heading p{color:#7c8ba5;margin:7px 0 22px}
    .register-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px 20px}.register-field{display:flex;flex-direction:column;gap:7px}.register-field label{font-weight:700;color:#33445e;font-size:14px}.register-field input,.register-field select{width:100%;height:46px;border:1px solid #d8e1ee;border-radius:10px;padding:0 13px;font-size:15px;outline:none;background:#fff}.register-field input:focus,.register-field select:focus{border-color:#3474f5;box-shadow:0 0 0 3px rgba(52,116,245,.10)}.register-full{grid-column:1/-1}.field-error{font-size:12px;color:#dc3545}.register-error{color:#dc3545;margin-bottom:12px}.register-button{width:100%;height:48px;border:0;border-radius:11px;background:#316cf4;color:#fff;font-weight:800;font-size:15px;margin-top:22px;cursor:pointer}.register-button:hover{background:#255fe5}.register-login{text-align:center;margin-top:18px;color:#74839b}.register-login a{color:#2563eb;font-weight:700;text-decoration:none}.register-footer{text-align:center;color:#9aa7b9;font-size:12px;margin-top:25px}
    @@media(max-width:700px){.register-card{padding:22px}.register-grid{grid-template-columns:1fr}.register-full{grid-column:auto}.register-heading h1{font-size:24px}}
</style>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
