@model QuanLyKyTucXa_UNETIxx_xxx.Models.PhongKTX
@{ ViewData["Title"] = "Thêm phòng"; var loai = (List<QuanLyKyTucXa_UNETIxx_xxx.Models.LoaiPhong>)ViewBag.LoaiPhongs; }
<h2>THÊM PHÒNG</h2><form asp-action="Create" method="post" class="col-md-7">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="SoPhong" class="form-label"></label><input asp-for="SoPhong" class="form-control"/><span asp-validation-for="SoPhong" class="text-danger"></span></div><div class="mb-3"><label asp-for="ToaNha" class="form-label"></label><input asp-for="ToaNha" class="form-control"/></div><div class="mb-3"><label asp-for="LoaiPhongId" class="form-label">Loại phòng</label><select asp-for="LoaiPhongId" class="form-select" asp-items="@(new SelectList(loai, "Id", "TenLoai"))"><option value="">-- Chọn --</option></select></div><div class="form-check mb-3"><input asp-for="DangHoatDong" class="form-check-input"/><label asp-for="DangHoatDong" class="form-check-label">Đang hoạt động</label></div><button class="btn btn-primary">Lưu</button> <a asp-action="Index" class="btn btn-secondary">Quay lại</a></form>
