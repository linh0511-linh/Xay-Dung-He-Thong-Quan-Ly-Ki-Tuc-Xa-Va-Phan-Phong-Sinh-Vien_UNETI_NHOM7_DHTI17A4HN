@using QuanLyKyTucXa_UNETIxx_xxx.ViewModels
@model PhongListViewModel
@{ ViewData["Title"] = "Quản lý phòng"; }
<div class="page-head room-page-head"><div><h1>Quản lý phòng</h1><p>Theo dõi tình trạng phòng và danh sách sinh viên đang lưu trú.</p></div><a asp-action="Create" class="btn btn-success rounded-3 px-4">+ Thêm phòng</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-4"><input name="search" value="@Model.Search" class="form-control" placeholder="Tìm số phòng / tòa nhà" /></div><div class="col-md-3"><select name="loaiPhongId" class="form-select" asp-items="@(new SelectList(Model.LoaiPhongs, "Id", "TenLoai", Model.LoaiPhongId))"><option value="">-- Tất cả loại phòng --</option></select></div><div class="col-md-3"><select name="sort" class="form-select"><option value="">Số phòng A-Z</option><option value="phong_desc">Số phòng Z-A</option><option value="toa">Theo tòa nhà</option></select></div><div class="col-md-2"><button class="btn btn-primary w-100">Lọc</button></div></form>
<table class="table table-striped table-bordered"><thead><tr><th>Số phòng</th><th>Tòa</th><th>Tầng</th><th>Loại</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var p in Model.Phongs){<tr><td>@p.SoPhong</td><td>@p.ToaNha</td><td>@p.Tang</td><td>@p.LoaiPhong?.TenLoai</td><td>@(p.DangHoatDong ? "Hoạt động" : "Tạm dừng")</td><td class="text-nowrap"><a asp-action="Students" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary me-1">Xem sinh viên</a> <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Sửa</a> <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline">@Html.AntiForgeryToken()<button class="btn btn-sm btn-danger" onclick="return confirm('Xóa phòng này?')">Xóa</button></form></td></tr>}</tbody></table>
<nav><ul class="pagination">@for(int i=1;i<=Model.TotalPages;i++){<li class="page-item @(i==Model.Page?"active":"")"><a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-loaiPhongId="@Model.LoaiPhongId" asp-route-sort="@Model.Sort">@i</a></li>}</ul></nav>

<div class="mt-4 mb-3">
    <h4 class="fw-bold mb-3">TỔNG KẾT TÌNH TRẠNG PHÒNG</h4>
    <div class="row g-3">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-secondary small">Tổng phòng đang hoạt động</div>
                <div class="fs-2 fw-bold text-primary">@ViewBag.TongPhongHoatDong</div>
            </div></div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-secondary small">Phòng còn trống hoàn toàn</div>
                <div class="fs-2 fw-bold text-success">@ViewBag.SoPhongTrong</div>
                <div class="small text-secondary">Chưa có sinh viên đang ở</div>
            </div></div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-secondary small">Phòng còn chỗ</div>
                <div class="fs-2 fw-bold text-info">@ViewBag.SoPhongConCho</div>
                <div class="small text-secondary">Có thể nhận thêm sinh viên</div>
            </div></div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-secondary small">Tổng chỗ còn trống</div>
                <div class="fs-2 fw-bold text-warning">@ViewBag.TongGiuongConTrong</div>
                <div class="small text-secondary">Sức chứa còn lại của các phòng đang hoạt động</div>
            </div></div>
        </div>
    </div>
</div>
