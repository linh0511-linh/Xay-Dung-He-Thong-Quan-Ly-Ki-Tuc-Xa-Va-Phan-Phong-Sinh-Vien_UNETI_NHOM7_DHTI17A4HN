@model List<QuanLyKyTucXa_UNETIxx_xxx.Models.LoaiPhong>
@{ ViewData["Title"]="Loại phòng"; }
<div class="page-head"><div><h1>Quản lý loại phòng</h1><p>Thiết lập sức chứa và giá phòng ký túc xá.</p></div><a class="btn btn-primary" asp-action="Create">+ Thêm loại phòng</a></div>
<div class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Tên loại phòng</th><th>Sức chứa</th><th>Giá / tháng</th><th>Số phòng</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><b>@x.TenLoai</b></td><td>@x.SucChua người</td><td>@x.GiaThang.ToString("N0") đ</td><td>@x.Phongs.Count</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id">Sửa</a> <form class="d-inline" asp-action="Delete" asp-route-id="@x.Id" method="post">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" onclick="return confirm('Xóa loại phòng này?')">Xóa</button></form></td></tr>}</tbody></table></div></div>
