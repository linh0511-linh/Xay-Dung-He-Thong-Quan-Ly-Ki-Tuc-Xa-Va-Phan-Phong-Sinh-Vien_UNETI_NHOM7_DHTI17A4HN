@model QuanLyKyTucXa_UNETIxx_xxx.Models.LoaiPhong
@{ ViewData["Title"]="Thêm loại phòng"; }
<div class="page-head"><div><h1>Thêm loại phòng</h1><p>Tạo cấu hình loại phòng mới.</p></div></div><div class="panel form-panel"><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="TenLoai" class="form-label"></label><input asp-for="TenLoai" class="form-control"/><span asp-validation-for="TenLoai" class="text-danger"></span></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="SucChua" class="form-label"></label><input asp-for="SucChua" class="form-control"/><span asp-validation-for="SucChua" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="GiaThang" class="form-label"></label><input asp-for="GiaThang" class="form-control"/><span asp-validation-for="GiaThang" class="text-danger"></span></div></div><div class="row">
<div class="col-md-6 mb-3"><label asp-for="ToaNhaTao" class="form-label">Tòa nhà tạo phòng</label><input asp-for="ToaNhaTao" class="form-control" placeholder="Ví dụ: B" maxlength="50"/><div class="form-text">Nhập tên tòa, ví dụ A, B, C.</div><span asp-validation-for="ToaNhaTao" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="SoLuongPhongTao" class="form-label">Số lượng phòng cần tạo</label><input asp-for="SoLuongPhongTao" type="number" min="0" max="200" class="form-control" value="1"/><div class="form-text">Hệ thống tự chọn số phòng còn chưa sử dụng trong tòa đã nhập. Ví dụ tòa B chưa có phòng, nhập 20 sẽ tạo phòng 1–20.</div><span asp-validation-for="SoLuongPhongTao" class="text-danger"></span></div>
</div><button class="btn btn-primary">Lưu</button> <a asp-action="Index" class="btn btn-light">Hủy</a></form></div>
